---
import Graph from "../components/Graph.astro";
import type { MarkdownInstance } from "astro";

type Directory = {
  [key: string]: Directory | MarkdownInstance<Record<string, any>>;
};
type DirEnd = Directory | MarkdownInstance<Record<string, any>>;

const allPosts = await Astro.glob("../pages/blogs/**/*.md");
const urls = allPosts.reduce((acc, post) => {
  const url = post.url;
  if (!url) {
    return acc;
  }

  const dirs = url.slice(1).split("/");
  // creating subdirectories
  let cd = acc;
  for (let i = 0; i < dirs.length - 1; i++) {
    if (!cd[dirs[i]]) {
      cd[dirs[i]] = {};
    }
    cd = cd[dirs[i]] as Directory; // guaranteed Directory
  }

  // placing files
  cd[dirs.at(-1)!] = post;

  return acc;
}, {} as Directory);
---

<ul class="menu bg-base-200 text-base-content min-h-full w-80 p-4">
  <Graph posts={allPosts} />
  <li></li>
  <!-- Sidebar content here -->
  <li><a href="/" class="w-full text-center">Homepage</a></li>
  <li></li>
  {
    (() => {
      const renderUrls = (name: string, d: DirEnd) => {
        // hack to decide if d is a file
        if (d.frontmatter) {
          return (
            <li>
              <a href={d.url as string}>{(d.frontmatter as any).title}</a>
            </li>
          );
        }

        return (
          <li>
            <details class="dropdown w-full p-0">
              <summary class="w-full pl-1 py-1 m-0">{name}</summary>
              <ul class="menu w-full bg-transparent rounded-box z-[1] ml-0.5 pr-0.5 ">
                {Object.keys(d).map((dirName: string) => {
                  return renderUrls(dirName, (d as Directory)[dirName]);
                })}
              </ul>
            </details>
          </li>
        );
      };
      return renderUrls("root", urls);
    })()
  }
</ul>
