---
import Graph from "../components/Graph.astro";
import type { MarkdownInstance } from "astro";

interface Props {
  currentPath?: string;
}

const { currentPath }: Props = Astro.props;

type Directory = {
  [key: string]: Directory | MarkdownInstance<Record<string, any>>;
};
type DirEnd = Directory | MarkdownInstance<Record<string, any>>;

const allPosts = await Astro.glob("../pages/blogs/**/*.md");
const urls = allPosts.reduce((acc, post) => {
  const url = post.url;
  if (!url) {
    return acc;
  }

  // drop the leading "blogs" segment: every post lives under it, so it's
  // just noise in the tree.
  const dirs = url.slice(1).split("/").slice(1);
  // creating subdirectories
  let cd = acc;
  for (let i = 0; i < dirs.length - 1; i++) {
    if (!cd[dirs[i]]) {
      cd[dirs[i]] = {};
    }
    cd = cd[dirs[i]] as Directory; // guaranteed Directory
  }

  // placing files
  cd[dirs.at(-1)!] = post;

  return acc;
}, {} as Directory);
---

<ul
  class="menu bg-base-200 rounded-box text-base-content w-full min-h-full p-2 gap-0.5"
>
  <Graph posts={allPosts} currentPath={currentPath} />
  <li></li>
  <!-- Sidebar content here -->
  <li>
    <a href="/" class:list={["w-full text-center", { active: currentPath === "/" }]}>
      Homepage
    </a>
  </li>
  <li>
    <a href="/tags" class:list={["w-full text-center", { active: currentPath === "/tags" }]}>
      Tags
    </a>
  </li>
  <li></li>
  {
    (() => {
      const renderUrls = (name: string, d: DirEnd) => {
        // hack to decide if d is a file
        if (d.frontmatter) {
          const url = d.url as string;
          return (
            <li>
              <a href={url} class:list={{ active: url === currentPath }}>
                {(d.frontmatter as any).title}
              </a>
            </li>
          );
        }

        return (
          <li>
            <details class="dropdown w-full p-0" open>
              <summary class="w-full pl-2 py-1.5 m-0">{name}</summary>
              <ul class="menu w-full bg-transparent rounded-box z-[1] ml-2 pr-1 gap-0.5">
                {Object.keys(d).map((dirName: string) => {
                  return renderUrls(dirName, (d as Directory)[dirName]);
                })}
              </ul>
            </details>
          </li>
        );
      };
      return Object.keys(urls).map((topKey) => renderUrls(topKey, urls[topKey]));
    })()
  }
</ul>
