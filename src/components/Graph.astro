---
interface Props {
  posts: Record<string, any>[];
  currentPath?: string;
}

const { posts, currentPath }: Props = Astro.props;

const postByUrl = new Map(posts.filter((p) => p.url).map((p) => [p.url, p]));

function shortLabel(title: string, max = 18): string {
  return title.length > max ? title.slice(0, max - 1) + "…" : title;
}

// Theme colours rather than fixed hex, so the graph follows light/dark mode.
// Written as whole literal class names so Tailwind picks them up.
const groupClasses = [
  "text-primary",
  "text-accent",
  "text-secondary",
  "text-info",
  "text-success",
];

const groupNames = [
  ...new Set(posts.filter((p) => p.url).map((p) => p.url.split("/")[2] ?? "root")),
];

const nodes = [...postByUrl.values()].map((post) => {
  const title = (post.frontmatter?.title as string) ?? post.url;
  const group = (post.url as string).split("/")[2] ?? "root";
  return {
    id: post.url as string,
    title,
    label: shortLabel(title),
    colorClass: groupClasses[groupNames.indexOf(group) % groupClasses.length],
    current: post.url === currentPath,
  };
});

// URLs can contain literal parentheses (e.g. rnns_(recurrent_neural_networks)),
// so a generic `](...)` regex can't reliably find the closing paren. Since the
// set of valid targets is known ahead of time, just check for each directly.
const links: { source: string; target: string }[] = [];

for (const post of postByUrl.values()) {
  if (typeof post.rawContent !== "function") continue;
  const raw = post.rawContent();
  for (const targetUrl of postByUrl.keys()) {
    if (targetUrl !== post.url && raw.includes(`](${targetUrl})`)) {
      links.push({ source: post.url, target: targetUrl });
    }
  }
}

// Notes nothing links to (and that link to nothing) get laid out as a ring of
// islands around the connected cluster, rather than piling up on an edge.
const linked = new Set(links.flatMap((l) => [l.source, l.target]));
for (const node of nodes) {
  (node as any).isolated = !linked.has(node.id);
}
---

<div id="graph-container" class="w-full h-[30rem] bg-base-200 rounded-box mb-2"></div>
<script type="module" define:vars={{ nodes_: nodes, links_: links }} is:inline>
  import * as d3 from "https://cdn.jsdelivr.net/npm/d3@7/+esm";

  const nodes = nodes_;
  const links = links_;

  const graphContainer = document.querySelector("#graph-container");

  // Specify the dimensions of the chart.
  const width = graphContainer.offsetWidth;
  const height = graphContainer.offsetHeight;
  const margin = 14;

  // Create a simulation with several forces. The x/y forces keep unlinked
  // notes gathered near the middle instead of being flung to the edges.
  const simulation = d3
    .forceSimulation(nodes)
    .force(
      "link",
      d3.forceLink(links).id((d) => d.id).distance(70)
    )
    .force("charge", d3.forceManyBody().strength(-260))
    .force("center", d3.forceCenter(width / 2, height / 2))
    .force("x", d3.forceX(width / 2).strength(0.03))
    .force("y", d3.forceY(height / 2).strength(0.03))
    .force(
      "islands",
      d3
        .forceRadial(
          Math.min(width, height) * 0.44,
          width / 2,
          height / 2
        )
        .strength((d) => (d.isolated ? 0.5 : 0))
    )
    .force("collide", d3.forceCollide(22))
    .on("tick", ticked);

  // Create the SVG container.
  const svg = d3
    .create("svg")
    .attr("width", width)
    .attr("height", height)
    .attr("viewBox", [0, 0, width, height])
    .attr("style", "max-width: 100%; height: auto;");

  // Add a line for each link, and a circle for each node.
  const link = svg
    .append("g")
    .attr("class", "stroke-base-content")
    .attr("stroke-opacity", 0.3)
    .selectAll()
    .data(links)
    .join("line")
    .attr("stroke-width", 1.5);

  const node = svg
    .append("g")
    .attr("class", "stroke-base-100")
    .selectAll()
    .data(nodes)
    .join("circle")
    .attr("r", (d) => (d.current ? 8 : 5))
    .attr("fill", "currentColor")
    .attr("class", (d) => (d.current ? "text-warning" : d.colorClass))
    .attr("stroke-width", (d) => (d.current ? 2.5 : 1.5))
    .attr("cursor", "pointer")
    .on("click", (event, d) => {
      window.location.href = d.id;
    });

  node.append("title").text((d) => d.title);

  // Persistent labels, since a title tooltip alone doesn't tell you what's
  // in the graph without hovering every node.
  const label = svg
    .append("g")
    .selectAll()
    .data(nodes)
    .join("text")
    .attr(
      "class",
      (d) =>
        `fill-current pointer-events-none select-none ${
          d.current ? "text-warning font-semibold" : "text-base-content/70"
        }`
    )
    .attr("font-size", (d) => (d.current ? 11 : 9))
    .attr("dy", 3)
    .text((d) => d.label);

  // Add a drag behavior.
  node.call(
    d3.drag().on("start", dragstarted).on("drag", dragged).on("end", dragended)
  );

  // Set the position attributes of links and nodes each time the simulation ticks.
  function ticked() {
    // Keep every note inside the frame, so island notes can't drift out of
    // view and labels never get clipped at the edge.
    nodes.forEach((d) => {
      d.x = Math.max(margin, Math.min(width - margin, d.x));
      d.y = Math.max(margin, Math.min(height - margin, d.y));
    });

    link
      .attr("x1", (d) => d.source.x)
      .attr("y1", (d) => d.source.y)
      .attr("x2", (d) => d.target.x)
      .attr("y2", (d) => d.target.y);

    node.attr("cx", (d) => d.x).attr("cy", (d) => d.y);
    label
      .attr("x", (d) => d.x + (d.x > width / 2 ? -10 : 10))
      .attr("y", (d) => d.y)
      .attr("text-anchor", (d) => (d.x > width / 2 ? "end" : "start"));
  }

  // Reheat the simulation when drag starts, and fix the subject position.
  function dragstarted(event) {
    if (!event.active) simulation.alphaTarget(0.3).restart();
    event.subject.fx = event.subject.x;
    event.subject.fy = event.subject.y;
  }

  // Update the subject (dragged node) position during drag.
  function dragged(event) {
    event.subject.fx = event.x;
    event.subject.fy = event.y;
  }

  // Restore the target alpha so the simulation cools after dragging ends.
  // Unfix the subject position now that it’s no longer being dragged.
  function dragended(event) {
    if (!event.active) simulation.alphaTarget(0);
    event.subject.fx = null;
    event.subject.fy = null;
  }

  graphContainer.append(svg.node());
</script>
