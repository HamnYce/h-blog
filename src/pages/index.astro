---
import BaseLayout from "../layouts/BaseLayout.astro";

const allPosts = await Astro.glob("./blogs/**/*.md");

const recentPosts = allPosts
  .filter((post) => post.url && post.frontmatter?.pubDate)
  .sort(
    (a, b) =>
      new Date(b.frontmatter.pubDate).getTime() -
      new Date(a.frontmatter.pubDate).getTime()
  )
  .slice(0, 8);
---

<BaseLayout pageTitle="Hamnyce's H-Blog">
  <p class="text-lg max-w-2xl mb-8">
    This is a space where I share my notes, reflections, and projects that I
    believe could be useful to others. Drag the graph on the left to explore
    how the notes connect, or browse by <a href="/tags" class="link link-hover">tag</a>.
  </p>

  <h2 class="text-2xl mb-2">Recent Posts</h2>
  <ul class="menu bg-base-200 rounded-box w-full max-w-xl">
    {
      recentPosts.map((post) => (
        <li>
          <a href={post.url} class="flex justify-between gap-4">
            <span>{post.frontmatter.title}</span>
            <span class="text-sm opacity-60 whitespace-nowrap">
              {post.frontmatter.pubDate}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
